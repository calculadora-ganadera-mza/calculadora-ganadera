DB_USERNAME=Usuario
DB_PASSWORD=Clave
DB_HOST=db
DB_PORT=5432
DB_DATABASE=calculadora_ganadera

# Generate with: openssl rand -hex 32. Required for authentication.
JWT_SECRET_KEY=
