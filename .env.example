DB_USERNAME=Usuario
DB_PASSWORD=Clave
DB_HOST=db
DB_PORT=5432
DB_DATABASE=calculadora_ganadera

# Generar con: openssl rand -hex 32. Obligatoria para la autenticación.
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Usar false solo para desarrollo local con HTTP. Usar true en producción con HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=["http://localhost:5173"]
