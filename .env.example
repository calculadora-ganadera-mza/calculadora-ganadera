DB_USERNAME=Usuario
DB_PASSWORD=Clave
DB_HOST=db
DB_PORT=5432
DB_DATABASE=calculadora_ganadera

# Generar con: openssl rand -hex 32. Obligatoria para la autenticación.
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Usar false solo para desarrollo local con HTTP. Usar true en producción con HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=["http://localhost:5173"]

# Zona horaria de la fecha "de hoy" en el backend. El servidor suele estar en UTC.
APP_TIMEZONE=America/Argentina/Mendoza

# Servidor de correo. En desarrollo, Mailpit: los correos se ven en http://localhost:8025.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="Calculadora ganadera <no-responder@calculadora-ganadera.test>"
# Vacíos y en false para Mailpit. En producción, los datos del proveedor de correo.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=false

# Códigos por correo: minutos de validez, intentos fallidos permitidos,
# segundos de espera para pedir otro y máximo de códigos por hora.
VERIFICATION_CODE_MINUTES=15
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_RESEND_SECONDS=60
VERIFICATION_CODES_PER_HOUR=5
PASSWORD_RESET_CODE_MINUTES=15
PASSWORD_RESET_CODE_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_RESEND_SECONDS=60
PASSWORD_RESET_CODES_PER_HOUR=5
